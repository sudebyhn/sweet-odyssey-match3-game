# Başlamak için bu dosyaya ihtiyaç yok. Varsayılan: SQLite + localhost.
# İsteğe bağlı: .env adıyla kopyalayıp aşağıdaki değerleri açabilirsin.

# SWEET_PORT=8000
# Geliştirme için isteğe bağlı; varsayılan aynı kaynak:
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SWEET_DATA_DIR=./data

# PostgreSQL kullanacaksan gerçek parolanı yalnızca yerel .env içinde tut.
# DATABASE_URL=postgresql+psycopg://sweet:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/sweet_odyssey
# POSTGRES_USER=sweet
# POSTGRES_DB=sweet_odyssey
# POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
